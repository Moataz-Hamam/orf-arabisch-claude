# Kopiere diese Datei zu ".env" und trage deinen echten Key ein.
# ".env" wird via .gitignore NIE eingecheckt.

# Pflicht: API-Key von https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Feed-URL überschreiben (Standard: ORF Schlagzeilen)
ORF_RSS_URL=https://rss.orf.at/news.xml

# Optional: Claude-Modell für die Übersetzung
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: maximale Anzahl gespeicherter Nachrichten
MAX_ITEMS=60
